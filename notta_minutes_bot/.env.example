# Notion（Nottaから手動エクスポートした文字起こしを溜めるデータベース）
# NOTION_API_KEYはNotionで「Internal Integration」を作成して発行したトークン。
# 対象データベースをそのIntegrationに共有（Connect）しておくこと。
NOTION_API_KEY=
NOTION_DATABASE_ID=
# データベースに用意したチェックボックス型プロパティの名前
NOTION_PROCESSED_PROPERTY=処理済み

# Claude (Anthropic API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Google Drive（文字起こし・議事録の保存先。Claude ProjectのGoogle Drive連携で
# このフォルダを指定すると、Project側のナレッジに自動反映される）
GOOGLE_SERVICE_ACCOUNT_JSON=/secrets/service_account.json
DRIVE_FOLDER_ID=

# タスクリストを溜めていく単一のGoogle Sheets。事前にスプレッドシートを
# 作成し、1行目に 日付/会議名/担当者/タスク/期限/完了 のヘッダーを入れ、
# サービスアカウントのメールアドレスに編集者共有しておくこと。
TASK_SHEET_ID=
TASK_SHEET_TAB=シート1

# 議事録・タスクリスト生成完了の通知メール（Gmail SMTP + アプリパスワード）
# GMAIL_USERの2段階認証を有効化し、Googleアカウント設定で発行した
# アプリパスワードをGMAIL_APP_PASSWORDに設定する。
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL_TO=

# /poll エンドポイントを簡易に保護するための共有シークレット（任意）
# Cloud SchedulerのHTTPターゲットURLに ?secret=xxxx を付けて設定し、
# ここに同じ値を設定する
POLL_SHARED_SECRET=
