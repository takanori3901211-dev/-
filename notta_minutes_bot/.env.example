# Notta
NOTTA_API_KEY=
NOTTA_API_BASE_URL=https://api.notta.ai/v1
# Notta側のWebhook設定画面で見れる署名/共有シークレットがあれば設定（未提供なら空でよい）
NOTTA_WEBHOOK_SECRET=

# Claude (Anthropic API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Google Drive（文字起こし・議事録の保存先。Claude ProjectのGoogle Drive連携で
# このフォルダを指定すると、Project側のナレッジに自動反映される）
GOOGLE_SERVICE_ACCOUNT_JSON=/secrets/service_account.json
DRIVE_FOLDER_ID=

# Webhookサーバー自体を簡易に保護するための共有シークレット（任意）
# NottaのWebhook URLに ?secret=xxxx を付けて登録し、ここに同じ値を設定する
INBOUND_WEBHOOK_SHARED_SECRET=
